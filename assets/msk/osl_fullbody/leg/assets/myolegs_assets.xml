<mujocoinclude model="MyoLegs_v0.0.1">
<!-- =================================================
    Copyright 2025 Vikash Kumar, Vittorio Caggiano, Huawei Wang
    Model	:: Myo Legs (MuJoCoV2.0)
    Author	:: Vikash Kumar (vikashplus@gmail.com), Vittorio Caggiano, Huawei Wang
    Source	:: https://github.com/MyoHub/myosuite
    License	:: Under Apache License, Version 2.0 (the "License"); you may not use this file except in compliance with the License. You may obtain a copy of the License at http://www.apache.org/licenses/LICENSE-2.0 Unless required by applicable law or agreed to in writing, software distributed under the License is distributed on an "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the License for the specific language governing permissions and limitations under the License.

    Modified by MuscleMimic Team (2025-2026):
      - Integrated into MyoFullBody and BimanualMuscle configurations
      - Corrected left-right limb asymmetries
      - Added collision geometry for self-contact pairs
====================================================== -->

    <compiler angle="radian" inertiafromgeom="auto"/>
    <option timestep="0.001"/>

    <size nconmax="2000" njmax="5000" nkey="1" nuser_jnt="1"/>
    <!-- <visual>
        <headlight ambient=".5 .5 .5" diffuse="0.50 0.50 0.50" specular="0.50 0.50 0.50"/>
    </visual> -->
    <default class="main">
        <default class="myolegs">
            <joint armature="0.01" damping="0.5" limited="true"/>
            <geom margin="0.001" material="mat_myolegs" rgba="0.8 0.85 0.8 1" conaffinity="0" contype="0"/>
            <site size="0.001 0.005 0.005" group="3"/>
            <default class="myoleg_muscle">
                <tendon rgba="0.95 0.3 0.3 1" width="0.005"/>
                <general biasprm="0.75 1.05 -1 400 0.5 1.6 1.5 1.3 1.2 0" biastype="muscle" ctrllimited="true" ctrlrange="0 1" dynprm="0.01 0.04 0 0 0 0 0 0 0 0" dyntype="muscle" gainprm="0.75 1.05 -1 400 0.5 1.6 1.5 1.3 1.2 0" gaintype="muscle"/>
            </default>
            <default class="myoleg_wrap">
                <geom rgba=".5 .5 .9 0.5" group="3" contype="0" conaffinity="0"  type="cylinder"/>
            </default>
            <default class="coll">
                <geom type="capsule" mass="0" group="4" contype="1" conaffinity="0" condim="3" rgba="0.8 0.7 .5 .1" margin="0.001" material="MatSkin_myoleg"/>
            </default>
            <default class="myo_leg_touch">
                <site type="box" group="3" rgba="0.8 0.2 .2 .4"/>
            </default>
            <default class="myo_leg_marker">
                <site size="0.02" group="4" rgba="0.8 0.8 .2 1"/>
            </default>
        </default>
    </default>

    <contact>
        <!-- Right biological shank/foot collision geoms were amputated; only r_femur1_col
             remains on the right side. Surviving biological self-contact pairs: -->
        <pair geom1="r_femur1_col" geom2="l_femur1_col" condim="1"/>
        <pair geom1="r_femur1_col" geom2="l_tibia1_col" condim="1"/>
        <pair geom1="r_femur1_col" geom2="l_tibia2_col" condim="1"/>

        <!-- OSL prosthesis vs left limb (from myoLeg80_OSL_KA) -->
        <pair geom1="osl_femoral_pylon_geom_1" geom2="l_femur2_col" condim="1"/>
        <pair geom1="osl_proximal_adapter_geom_1" geom2="l_femur2_col" condim="1"/>

        <pair geom1="l_tibia1_col" geom2="osl_knee_assembly_geom_1" condim="1"/>
        <pair geom1="l_tibia1_col" geom2="osl_tibial_pylon_geom_1" condim="1"/>
        <pair geom1="l_tibia1_col" geom2="osl_ankle_assembly_geom_1" condim="1"/>

        <pair geom1="l_tibia2_col" geom2="osl_knee_assembly_geom_1" condim="1"/>
        <pair geom1="l_tibia2_col" geom2="osl_tibial_pylon_geom_1" condim="1"/>
        <pair geom1="l_tibia2_col" geom2="osl_ankle_assembly_geom_1" condim="1"/>

        <pair geom1="l_foot_col1" geom2="osl_ankle_assembly_geom_1" condim="1"/>
        <pair geom1="l_foot_col1" geom2="osl_foot_assembly_geom_1" condim="1"/>
        <pair geom1="l_foot_col4" geom2="osl_ankle_assembly_geom_1" condim="1"/>
        <pair geom1="l_foot_col4" geom2="osl_foot_assembly_geom_1" condim="1"/>

        <pair geom1="l_femur1_col" geom2="osl_knee_assembly_geom_1" condim="1"/>
        <pair geom1="l_femur1_col" geom2="osl_tibial_pylon_geom_1" condim="1"/>
        <pair geom1="l_femur1_col" geom2="osl_ankle_assembly_geom_1" condim="1"/>

        <pair geom1="l_femur2_col" geom2="osl_knee_assembly_geom_1" condim="1"/>
        <pair geom1="l_femur2_col" geom2="osl_tibial_pylon_geom_1" condim="1"/>
        <pair geom1="l_femur2_col" geom2="osl_ankle_assembly_geom_1" condim="1"/>

        <pair geom1="osl_femoral_pylon_geom_1" geom2="l_tibia1_col" condim="1"/>
        <pair geom1="osl_proximal_adapter_geom_1" geom2="l_tibia1_col" condim="1"/>
        <pair geom1="osl_femoral_pylon_geom_1" geom2="l_tibia2_col" condim="1"/>
        <pair geom1="osl_proximal_adapter_geom_1" geom2="l_tibia2_col" condim="1"/>
    </contact>


    <asset>
        <texture name="tex_myolegs" builtin="flat" height="762" mark="cross" markrgb="1 .9 .9" rgb1="1 1 1" rgb2="1 1 1" type="cube" width="127"/>
        <material name="mat_myolegs" texture="tex_myolegs" texuniform="true"/>
        <material name="MatSkin_myoleg" specular="0.2" shininess=".1" reflectance="0.5" rgba="0.8 0.7 .5 .1" />
        
        <mesh file="meshes/r_pelvis.stl" name="r_pelvis"/>
        <mesh file="meshes/l_pelvis.stl" name="l_pelvis"/>
        <!-- Right biological lower-limb meshes removed (amputated). OSL prosthesis meshes: -->
        <mesh file="meshes/osl_femur_trans_r.stl" name="mesh_femur_trans_r"/>
        <mesh file="meshes/osl_generic_socket.stl" name="prosthetic_socket_geom_1_generic_socket"/>
        <mesh file="meshes/osl_proximal_adapter_v2.stl" name="osl_proximal_adapter_geom_1_osl_proximal_adapter_v2"/>
        <mesh file="meshes/osl_knee_v2.stl" name="osl_knee_assembly_geom_1_osl_knee_v2"/>
        <mesh file="meshes/osl_ankle_v2.stl" name="osl_ankle_assembly_geom_1_osl_ankle_v2"/>
        <mesh file="meshes/osl_custom_foot_v2.stl" name="osl_foot_assembly_geom_1_osl_custom_foot_v2"/>
        <mesh file="meshes/l_femur.stl" name="l_femur"/>
        <mesh file="meshes/l_tibia.stl" name="l_tibia"/>
        <mesh file="meshes/l_fibula.stl" name="l_fibula"/>
        <mesh file="meshes/l_talus.stl" name="l_talus"/>
        <mesh file="meshes/l_foot.stl" name="l_foot"/>
        <mesh file="meshes/l_bofoot.stl" name="l_bofoot"/>
        <mesh file="meshes/l_patella.stl" name="l_patella"/>
    </asset>

    <equality>
        <!-- Right knee coupling constraints removed with the amputated right knee/patella. -->
        <joint joint1="knee_angle_translation2_l" joint2="knee_angle_l" name="knee_angle_translation2_constraint_l" polycoef="-7.69254e-11 -0.00587971 0.00125622 2.61846e-06 -6.24355e-07" solimp="0.9999 0.9999 0.001 0.5 2"/>
        <joint joint1="knee_angle_translation1_l" joint2="knee_angle_l" name="knee_angle_translation1_constraint_l" polycoef="9.53733e-08 0.00312879 -0.00230804 0.000561561 5.68366e-07" solimp="0.9999 0.9999 0.001 0.5 2"/>
        <joint joint1="knee_angle_rotation2_l" joint2="knee_angle_l" name="knee_angle_rotation2_constraint_l" polycoef="-1.47325e-08 0.0791 -0.0328478 -0.0252183 0.0108321" solimp="0.9999 0.9999 0.001 0.5 2"/>
        <joint joint1="knee_angle_rotation3_l" joint2="knee_angle_l" name="knee_angle_rotation3_constraint_l" polycoef="-1.08939e-08 -0.369499 0.169478 -0.0251643 -3.50498e-07" solimp="0.9999 0.9999 0.001 0.5 2"/>
        <joint joint1="knee_angle_beta_translation2_l" joint2="knee_angle_l" name="knee_angle_beta_translation2_constraint_l" polycoef="-0.0108281 -0.0487847 0.00927644 0.0131673 -0.00349673" solimp="0.9999 0.9999 0.001 0.5 2"/>
        <joint joint1="knee_angle_beta_translation1_l" joint2="knee_angle_l" name="knee_angle_beta_translation1_constraint_l" polycoef="0.0524192 -0.0150188 -0.0340522 0.0133393 -0.000879151" solimp="0.9999 0.9999 0.001 0.5 2"/>
        <joint joint1="knee_angle_beta_rotation1_l" joint2="knee_angle_l" name="knee_angle_beta_rotation1_constraint_l" polycoef="0.010506 0.0247615 -1.31647 0.716337 -0.138302" solimp="0.9999 0.9999 0.001 0.5 2"/>
    </equality>

    <sensor>
        <!-- Right biological foot/toe touch sensors replaced by OSL prosthesis sensors -->
        <touch name="r_osl_foot" site="r_osl_foot_touch"/>
        <force name="r_osl_load" site="r_osl_load_force"/>
        <force name="r_socket_load" site="r_socket_load_force"/>
        <touch name="l_foot" site="l_foot_touch"/>
        <touch name="l_toes" site="l_toes_touch"/>
    </sensor>

</mujocoinclude>